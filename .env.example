# Copy to .env; fixture mode makes no model or search calls.
EVIDENCEFORGE_MODEL_PROVIDER=fixture
EVIDENCEFORGE_MODEL_ID=
EVIDENCEFORGE_MODEL_API_KEY=
EVIDENCEFORGE_TAVILY_API_KEY=
EVIDENCEFORGE_DATA_DIR=.evidenceforge
EVIDENCEFORGE_TRACING_ENABLED=false
EVIDENCEFORGE_BUDGET__MAX_RESEARCH_PASSES=3
EVIDENCEFORGE_BUDGET__MAX_REWRITES=2
EVIDENCEFORGE_BUDGET__MAX_SEARCHES=12
EVIDENCEFORGE_BUDGET__MAX_MODEL_CALLS=32


# Optional counters-only LangSmith verification; keep private.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evidenceforge
LANGSMITH_TRACING=false
